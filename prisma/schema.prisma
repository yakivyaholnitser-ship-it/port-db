datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PortEntry {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // Core identification
  port      String
  country   String?
  terminal  String
  operation String   // "Load" | "Discharge" | "Bunker" etc.

  // 🔹 Coordinates for Map
  lat Float?
  lon Float?

  // Cargo / productivity
  cargo                String?
  stowFactor           String?
  quantityInfo         String?
  typeOfCargoesHandled String?
  productionPerDay     String?
  numberOfGangs        String?
  shiftsInfo           String?
  equipmentUsed        String?
  shiftsPerDay         String?

  // Dimensions / hydro
  waterDensity            String?
  maxDraftMeters          String?
  maxDraftNotes           String?
  loaMeters               String?
  beamMeters              String?
  maxDwtMt                String?
  airDraftMeters          String?
  spoutAirDraft           String?
  waterlineToHatchCoaming String?
  minFreeboardMeters      String?
  requiredTrim            String?

  // Rates
  loadRatePerDayMt      String?
  dischargeRatePerDayMt String?

  // Ops & costs
  agents            String?
  costDockage       String?
  costPilotage      String?
  costTowage        String?
  costTotalEstimate String?

  // Ops details
  transitPsNotes    String?
  bunkeringPlace    String?
  cleaningPermitted String?
  sulphurLimit      String?

  bunkeringNotes String?
  cleaningNotes  String?

  // Restrictions / misc
  specialRestrictions String?
  otherInfo           String?
  restrictionsJson    String?

  // Source tracking
  dataSource String?   // e.g. "GAC", "Sinoagent", "COSCO Shipping"
  sourceDate DateTime? // date agent provided this info (≠ createdAt)

  // raw text for re-parsing
  rawText String
}